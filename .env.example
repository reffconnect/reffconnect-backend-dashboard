# Copy this file to `.env` and fill in your own values.
# Never commit `.env` — it is gitignored.

# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
# Port the API listens on. The frontend's .env.example already expects
# http://localhost:8000/api/v1, so 8000 keeps a future switch friction-free.
PORT=8000
# Comma-separated list of allowed CORS origins (the frontend dev servers).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database (Postgres) ─────────────────────────────────────────────
# This backend uses its OWN Postgres database and never touches the
# Supabase project used by the current app. Point this at any Postgres
# instance (local Docker, RDS, a separate Supabase DB, etc.).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connectx
# Set to true when connecting to a managed Postgres that requires TLS.
DATABASE_SSL=false

# ── Auth / JWT ──────────────────────────────────────────────────────
# Generate strong random secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
# Access token lifetime (short) and refresh token lifetime (long).
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# ── Login lockout (per-account) ─────────────────────────────────────
# Complements the IP-based auth limiter above: after LOGIN_MAX_FAILS failed
# logins for one email within LOGIN_FAIL_WINDOW_MS, that account is temporarily
# locked (window doubles as the lock duration). Requires Redis; fails OPEN (no
# lockout) when Redis is unset/unreachable, so local dev is unaffected.
LOGIN_MAX_FAILS=10
LOGIN_FAIL_WINDOW_MS=900000

# ── Cache / Redis (optional, recommended in production) ─────────────
# When set, enables a shared cache AND multi-instance-safe rate limiting.
# Leave it unset for local dev: the API degrades gracefully to in-memory
# rate limiting (single instance only) and simply skips caching.
# REDIS_URL=redis://localhost:6379

# ── Database pool / scaling ─────────────────────────────────────────
# Per-instance connection pool size. Budget instances * DB_POOL_MAX against
# your Postgres max_connections, OR put PgBouncer in front and pool freely.
DB_POOL_MAX=10
DB_POOL_MIN=0
# Optional read replica. Reads that tolerate replication lag are routed here
# via queryReplica(); falls back to the primary when unset. Do NOT point this
# at a replica for read-your-write paths.
# DATABASE_REPLICA_URL=postgresql://postgres:postgres@localhost:5432/connectx
# Per-statement timeout in ms (0 disables). Stops a runaway query from holding
# a pooled connection and starving the rest of the app.
DB_STATEMENT_TIMEOUT_MS=15000

# ── Integrations (all optional; each feature fails closed with 503 until set) ──
# Payments (Razorpay). Key secret signs/verifies; webhook secret is separate.
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
# Platform take rate in basis points (1500 = 15%).
PLATFORM_FEE_BPS=1500

# Video (Daily.co).
# DAILY_API_KEY=xxx

# Email (Resend). Without these, mail is queued in the email_outbox table only.
# RESEND_API_KEY=re_xxx
# SENDER_EMAIL=no-reply@yourdomain.com
WEBSITE_URL=http://localhost:3000

# AI (OpenAI) — resume parsing + drop screening. Falls back to deterministic when unset.
# OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# OAuth. Google needs only the client id; LinkedIn OIDC needs id + secret.
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# LINKEDIN_CLIENT_ID=xxx
# LINKEDIN_CLIENT_SECRET=xxx

# Work-email OTP hashing pepper (falls back to the refresh secret when unset).
# WORK_EMAIL_OTP_PEPPER=some-long-random-string

# ── Object storage ──────────────────────────────────────────────────
# Local disk provider by default (files under STORAGE_DIR, gitignored).
# Set STORAGE_PROVIDER=s3 for production; downloads still flow through the API
# behind a short-lived signed token (never public/presigned URLs).
STORAGE_PROVIDER=local
STORAGE_DIR=var/storage
STORAGE_DOWNLOAD_TTL=300
STORAGE_MAX_UPLOAD_MB=10

# S3 provider (only used when STORAGE_PROVIDER=s3). The bucket is REQUIRED in
# that mode — boot fails closed without it. Credentials are NOT read from here;
# they come from the standard AWS chain (env AWS_ACCESS_KEY_ID/SECRET, shared
# config, or an instance/task role), so a missing/denied credential also fails
# closed at call time. Endpoint + path-style enable S3-compatible stores (MinIO).
# STORAGE_S3_BUCKET=connectx-uploads
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_PREFIX=
# STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# STORAGE_S3_FORCE_PATH_STYLE=false
